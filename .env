APP_NAME="Hong Kong Restaurante"
APP_ENV=local
APP_KEY=base64:ctZf2uMoIfCdJNrHZcqH1Yq9sffAKqxy/SmWj8waJao=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hong_kong
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@hongkong.local"
MAIL_FROM_NAME="${APP_NAME}"
# Para que la recuperación de contraseña llegue por correo real, cambia MAIL_MAILER a smtp y completa MAIL_HOST, MAIL_PORT,
# MAIL_USERNAME y MAIL_PASSWORD. Con MAIL_MAILER=log el enlace solo se escribe en storage/logs/laravel.log (útil en pruebas).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_TIMEZONE=America/Lima

# ---- Cuenta inicial del administrador (opcional) ----
# Si defines ADMIN_PASSWORD, "php artisan migrate --seed" crea la cuenta. Después BORRA la contraseña de este archivo.
# Alternativa recomendada: dejarlo vacío y ejecutar "php artisan hongkong:crear-admin" (la contraseña se pide por pantalla).
ADMIN_USUARIO=administrador
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Pasarela de pago (confirmación automática) ----
# Clave compartida con la pasarela para firmar los avisos (HMAC-SHA256). Genérala larga y aleatoria. Vacía = desactivada.
PASARELA_SECRETO=

# Número de Yape del local (se muestra al cobrar con Yape)
YAPE_NUMERO=974608197
